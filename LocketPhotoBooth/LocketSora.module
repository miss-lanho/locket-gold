#!name=Locket Gold Full Tính Năng - Custom AI & Photobooth
#!desc=Mở khoá toàn bộ tính năng VIP không có trên app
#!author=sora
#!system=ios
[URL Rewrite]
^https://api.locketcamera.com/generateFilteredImage https://locket-img.onrender.com/generateFilteredImage 307
[Rule]
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
[Script]
RevenueCat - script hiện tại
locket_revenuecat = type=http-response, pattern=^https://api.revenuecat.com/.+/(receipts|subscribers), script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/LocketPhotoBooth/js/Locket_Sora.js, requires-body=true, max-size=-1, timeout=60
Xóa header cache
locket_delete_header = type=http-request, pattern=^https://(api.revenuecat.com|firebaseremoteconfig.googleapis.com)/.+, script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/LocketPhotoBooth/js/deleteHeader.js, timeout=60
Firebase Remote Config
locket_unlocked = type=http-response, pattern=^https://firebaseremoteconfig.googleapis.com/.+, script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/LocketPhotoBooth/js/Locket_Unlocked.js?widget_frame=https://i.ibb.co/TDzZcsNT/totoro.png, requires-body=true, max-size=-1, timeout=60
AI Filter / Photobooth
locket_filters = type=http-request, pattern=^https://(api.locketcamera.com|us-central1-locket-4252a.cloudfunctions.net)/(?:[^?#]/)?generateFilteredImage(?:?.)?$, script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/LocketPhotoBooth/js/Locket_Filters.js, requires-body=true, max-size=-1, timeout=120
Quote / Breaking News captions
locket_captions = type=http-request, pattern=^https://(api.locketcamera.com|us-central1-locket-4252a.cloudfunctions.net)/(?:[^?#]/)?generateCaption(?:?.)?$, script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/LocketPhotoBooth/js/Locket_Filters.js, requires-body=true, max-size=-1, timeout=35
[MITM]
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, firebaseremoteconfig.googleapis.com, api.revenuecat.com
