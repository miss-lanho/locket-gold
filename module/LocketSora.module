#!name=💛 Locket Gold Sora
#!desc=Unlocked Locket with all function
#!author=Sora
#!tele=https://t.me/miss_lanho



[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

#LocketGold
#hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/module/js/Locket_Sora.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/module/js/deleteHeader.js, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/module/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60
#************************************#

#RevenueCatVip
#hostname = api.revenuecat.com
RevenueCatVip = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/module/js/revenuecat.js, requires-body=true, max-size=-1, timeout=60
#RevenueCatDeleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/miss-lanho/locket-gold/refs/heads/main/module/js/deleteHeader.js, timeout=60
#************************************#


[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[MITM]
hostname = %APPEND%, *.googlevideo.com,  api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.rc-backup.com, buy.itunes.apple.com, spclient.wg.spotify.com, *spclient.spotify.com, us-central1-alight-creative.cloudfunctions.net
